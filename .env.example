# Zuno environment configuration — copy to .env and fill real values.
# NEVER commit the real .env file.

PORT=4000
NODE_ENV=development
# Comma-separated allowed frontend origins for CORS. Supports wildcard *.vercel.app for preview deploys.
# Local: http://localhost:4000,http://localhost:5500
# Production (Render→Vercel): https://your-zuno.vercel.app,https://*.vercel.app
FRONTEND_URL=http://localhost:4000,http://localhost:5500
API_BASE_URL=http://localhost:4000

# Database — SQLite (default, no setup) OR MongoDB Atlas (set MONGODB_URI to use Atlas)
# Local dev: leave MONGODB_URI blank → uses SQLite ./data/zuno.db (auto-seeded, admin idempotent)
# Production (Render): set MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/zuno?retryWrites=true for persistent Mongo
#              + DB_PATH=/data/ZUNO.db with Render disk (Starter plan) for SQLite persistence. Free tier: data/ZUNO.db is ephemeral (Mongo recommended).
MONGODB_URI=mongodb+srv://user:pass@cluster0.example.mongodb.net/zuno?retryWrites=true&w=majority
DB_PATH=./data/zuno.db

# Auth
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Razorpay (get from https://razorpay.com/dashboard)
# Leave blank to run in TEST MODE (simulated payments with a dev HMAC signature).
# Fill both key id + secret to switch the live Razorpay Checkout automatically.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Google sign-in (optional). Create OAuth2 credentials (Web) at
# https://console.cloud.google.com/apis/credentials and set the Client ID here.
# When set, the login screen renders the real "Continue with Google" button.
# Server verifies the id_token via Google's tokeninfo endpoint.
GOOGLE_CLIENT_ID=

# ── Email (TalkSpace Architecture) ──
# Primary: SMTP (Gmail). Fallback: Brevo / Resend via HTTPS (for Render free tier where 587 is blocked).
# Centralized service validated at startup — see server/config/email.js
# Gmail supports two ports:
#  - STARTTLS: 587 with SECURE=false (recommended, Render may block)
#  - Implicit TLS: 465 with SECURE=true (try if 587 times out on Render)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-16-char-gmail-app-password
SMTP_FROM=ZUNO <your-email@gmail.com>
# Optional fallback providers (HTTPS, no SMTP block):
# Get free keys at https://app.brevo.com (300/day) and https://resend.com
BREVO_API_KEY=
RESEND_API_KEY=
# Sender displayed in emails (must match SMTP_USER for Gmail to avoid 553)
NOTIFY_EMAIL_FROM=ZUNO <your-email@gmail.com>

# Printrove — automated POD fulfillment (https://api.printrove.com)
PRINTROVE_API_URL=https://api.printrove.com
PRINTROVE_EMAIL=
PRINTROVE_PASSWORD=

