{
  "version": 2,
  "builds": [
    { "src": "public/**", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/uploads/(.*)", "dest": "https://zuno-ydl3.onrender.com/uploads/$1" },
    { "src": "/api/(.*)", "dest": "https://zuno-ydl3.onrender.com/api/$1" },
    { "src": "/assets/(.*)", "dest": "/public/assets/$1" },
    { "src": "/(.*)", "dest": "/public/index.html" }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=86400, immutable" }]
    }
  ],
  "env": {
    "NODE_ENV": "production"
  }
}
